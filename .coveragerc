[run]
source = .
branch = True
omit =
    */migrations/*
    */tests/*
    */test_*.py
    */conftest.py
    */__init__.py
    */management/*
    .venv/*
    static_collected/*
    static/css/*
    config/asgi.py
    config/wsgi.py
    config/celery.py
    manage.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    \.\.\.

skip_covered = False
show_missing = True
precision = 1
