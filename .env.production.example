# ============================================================
# JAYMA — template environnement production
# Copier en .env.production et remplir chaque ligne.
# NE JAMAIS COMMIT .env.production (ajouté à .gitignore).
# ============================================================

# ==========  Django core  ==========
DJANGO_SETTINGS_MODULE=config.settings.production
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE_ME_50_CHARS_RANDOM
DJANGO_DEBUG=False
# Liste séparée par virgules, sans espaces
DJANGO_ALLOWED_HOSTS=jappesi.sn,.jappesi.sn,www.jappesi.sn
# Domaine racine pour générer les URLs de sous-domaines
JAYMA_ROOT_DOMAIN=jappesi.sn
# Taux commission par défaut (modifiable ensuite dans l'admin)
DEFAULT_COMMISSION_RATE=8.00

# ==========  PostgreSQL  ==========
POSTGRES_DB=jayma
POSTGRES_USER=jayma
# Générer un mot de passe fort (32+ chars)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ==========  Redis / Celery  ==========
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ==========  Email transactionnel (SendGrid / Postmark / Mailgun)  ==========
# Exemple SendGrid :
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=SG.your-sendgrid-api-key
DEFAULT_FROM_EMAIL=Jayma <noreply@jappesi.sn>

# ==========  SMS AfricasTalking (prod — compte avec crédits) ==========
# Panneau : https://account.africastalking.com
AT_USERNAME=jayma
AT_API_KEY=your-africastalking-api-key
AT_SENDER_ID=JAYMA   # ou numéro court validé (demander à AT)

# ==========  Wave Business Senegal  ==========
# Dashboard : https://business.wave.com
WAVE_API_KEY=wave-api-key
WAVE_BUSINESS_ID=your-business-id
WAVE_WEBHOOK_SECRET=webhook-signing-secret
# Webhook URL à configurer chez Wave :
#   https://jappesi.sn/paiements/webhook/wave/

# ==========  Orange Money Merchant SN  ==========
# Portail : https://developer.orange.com
OM_CLIENT_ID=your-client-id
OM_CLIENT_SECRET=your-client-secret
OM_MERCHANT_KEY=your-merchant-key
OM_WEBHOOK_SECRET=webhook-signing-secret
# Webhook URL à configurer :
#   https://jappesi.sn/paiements/webhook/orangemoney/

# ==========  CinetPay  ==========
# Dashboard : https://app.cinetpay.com
CINETPAY_API_KEY=your-api-key
CINETPAY_SITE_ID=your-site-id
CINETPAY_SECRET_KEY=your-secret-key
# Webhook URL à configurer :
#   https://jappesi.sn/paiements/webhook/cinetpay/

# ==========  Stockage images — Cloudflare R2  ==========
USE_R2=True
R2_BUCKET_NAME=jayma-prod
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
# Format endpoint : https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=https://xxxxxxxxxxxx.r2.cloudflarestorage.com
# Domaine public R2 custom (si configuré) : images.jappesi.sn
R2_PUBLIC_URL=images.jappesi.sn

# ==========  Observabilité  ==========
# Sentry DSN (gratuit, plan developer) : https://sentry.io
SENTRY_DSN=
# Plan : starter gratuit OK jusqu'à 5k erreurs/mois
