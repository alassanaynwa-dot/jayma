# ==============================================================
# JAPPESI — Variables d'environnement (exemple)
# Copier ce fichier en .env et remplir les valeurs.
# NE JAMAIS committer le vrai .env.
# ==============================================================

# --- Django ------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-moi-en-prod-avec-une-cle-longue-et-aleatoire
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,.jayma.local,.jappesi.sn

# Domaine racine — en dev on utilise .localhost (pas besoin d'/etc/hosts,
# *.localhost est résolu nativement sur 127.0.0.1). En prod : jappesi.sn
# JAYMA_ROOT_DOMAIN reste accepté comme alias rétro-compatible.
JAPPESI_ROOT_DOMAIN=localhost
JAPPESI_ROOT_PORT=8002

# --- Base de données PostgreSQL ----------------------------------
POSTGRES_DB=jayma
POSTGRES_USER=jayma
POSTGRES_PASSWORD=jayma_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# --- Redis -------------------------------------------------------
REDIS_URL=redis://localhost:6381/0
CELERY_BROKER_URL=redis://localhost:6381/1
CELERY_RESULT_BACKEND=redis://localhost:6381/2

# --- Email (dev → Mailpit) ---------------------------------------
EMAIL_HOST=localhost
EMAIL_PORT=1026
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=Jayma <noreply@jappesi.sn>

# --- SMS AfricasTalking ------------------------------------------
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=JAYMA

# --- Paiements Wave ---------------------------------------------
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
WAVE_BUSINESS_ID=

# --- Paiements Orange Money -------------------------------------
OM_MERCHANT_KEY=
OM_CLIENT_ID=
OM_CLIENT_SECRET=
OM_WEBHOOK_SECRET=

# --- Paiements CinetPay -----------------------------------------
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

# --- Stockage fichiers (prod → Cloudflare R2, dev → local) ------
USE_R2=False
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=jayma-media
R2_ENDPOINT_URL=
R2_PUBLIC_URL=

# --- Commission plateforme --------------------------------------
DEFAULT_COMMISSION_RATE=8.00
